<Window x:Class="PhotoClassy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoClassy - 사진 자동 분류"
        Width="1000" Height="860" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <!-- 1. 기본 설정 -->
        <Grid Grid.Row="0" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox Header="소스 폴더 (여러 개 선택 가능)">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                            <Button Content="추가" Command="{Binding AddSourceCommand}" Margin="0,0,0,4" />
                            <Button Content="제거" Command="{Binding RemoveSourceCommand}" Margin="0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SourceFolders}" SelectedItem="{Binding SelectedSourceFolder}"
                                 Height="92" ToolTip="분류할 사진이 들어있는 폴더 (하위 폴더 포함)" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="대상 폴더">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="선택" Command="{Binding SelectTargetCommand}" />
                        <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="2,3" />
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="파일 필터 (쉼표로 구분, 대소문자 구분 안 함)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="포함할 확장자" VerticalAlignment="Center" Margin="0,0,8,4" />
                        <TextBox Grid.Column="1" Text="{Binding IncludeText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" Padding="2,3"
                                 ToolTip="예: .jpg, .jpeg, .png, .gif, .bmp, .tiff (비어 있으면 모든 파일)" />
                        <TextBlock Grid.Row="1" Text="제외할 확장자" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="2,3" ToolTip="예: .txt, .ini (포함과 겹치면 제외가 우선)" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="Gray" FontSize="12"
                                   Text="둘 다 비어 있으면 모든 파일(RAW, 동영상 포함)이 대상입니다. 같은 확장자는 제외가 우선합니다. 숨김/시스템 파일(Thumbs.db 등)은 항상 제외합니다."
                                   TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <GroupBox Header="날짜 분류 방식">
                    <StackPanel>
                        <RadioButton GroupName="Format" Content="년-월 (YYYY/MM)" IsChecked="{Binding IsYearMonth}" Margin="0,2" />
                        <RadioButton GroupName="Format" Content="년-월-일 (YYYY/MM/DD)" IsChecked="{Binding IsYearMonthDay}" Margin="0,2" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="파일 처리 방식">
                    <StackPanel>
                        <RadioButton GroupName="Operation" Content="이동 (Move)" IsChecked="{Binding IsMove}" Margin="0,2" />
                        <RadioButton GroupName="Operation" Content="복사 (Copy)" IsChecked="{Binding IsCopy}" Margin="0,2" />
                    </StackPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="2,0,2,8"
                           Text="EXIF 촬영 시간이 없으면 수정일(없으면 생성일)로 분류합니다. 중복 파일은 대상 폴더의 _Duplicates 폴더에 모읍니다. 이동 모드에서는 비게 된 소스 하위 폴더를 삭제합니다." />
            </StackPanel>
        </Grid>

        <!-- 2. 실행 버튼 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="설정 초기화" Command="{Binding ResetSettingsCommand}" Margin="0" />
            <Button DockPanel.Dock="Right" Content="취소" Command="{Binding CancelCommand}" MinWidth="100" />
            <Button DockPanel.Dock="Right" Content="▶ 분류 시작" Command="{Binding StartCommand}" MinWidth="140"
                    FontWeight="Bold" IsDefault="True" />
        </DockPanel>

        <!-- 3. 진행 상황 -->
        <GroupBox Grid.Row="2" Header="진행 상황">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="Bold" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding StageText}" FontWeight="SemiBold" FontSize="14" />
                </DockPanel>
                <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />

                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="전체:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="처리됨:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding ProcessedText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="남은 파일:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding RemainingText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="현재:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding CurrentIndexText}" />
                </WrapPanel>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource StatLabel}" Text="현재 파일:" />
                    <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding CurrentFileName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="경로:" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentFilePath}" Foreground="#444"
                               TextTrimming="CharacterEllipsis" Margin="0,2" ToolTip="{Binding CurrentFilePath}" />
                </Grid>

                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="경과:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="평균:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding AverageText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="예상 전체:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding EstimatedTotalText}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="남은 시간:" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding RemainingTimeText}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding CompletionText}" Foreground="#1565C0" />
                </WrapPanel>
                <TextBlock Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                           Text="※ 평균/남은 시간은 현재 단계의 처리 속도로 계산합니다." />
            </StackPanel>
        </GroupBox>

        <!-- 4. 실시간 로그 -->
        <GroupBox Grid.Row="3" Header="실시간 로그" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="대상 폴더 열기" Command="{Binding OpenTargetCommand}" />
                    <Button Content="로그 지우기" Command="{Binding ClearLogCommand}" />
                    <Button Content="로그 저장" Command="{Binding SaveLogCommand}" />
                </StackPanel>
                <ListView x:Name="LogList" ItemsSource="{Binding Log}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="Consolas, Malgun Gothic" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="시간" Width="70"
                                            DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}" />
                            <GridViewColumn Header="" Width="34">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="내용" Width="480" DisplayMemberBinding="{Binding Message}" />
                            <GridViewColumn Header="파일" Width="340" DisplayMemberBinding="{Binding Path}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
