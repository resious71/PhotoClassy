<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <!-- .NET Framework 4.7.2 가 없으면 먼저 설치한 뒤 PhotoClassy MSI 를 설치하는 설치 프로그램 (PhotoClassySetup.exe) -->
  <Bundle Name="PhotoClassy"
          Manufacturer="PhotoClassy"
          Version="1.0.0.0"
          UpgradeCode="3D8A6F1C-2B4E-4C7D-9E0F-5A1B3C5D7E92"
          IconSourceFile="..\..\src\PhotoClassy\PhotoClassy.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseFile="..\PhotoClassy.Installer\License.rtf"
                                              Theme="rtfLicense" />
    </BootstrapperApplication>

    <Chain>
      <!-- 오프라인 설치를 위해 재배포 패키지를 번들에 포함 -->
      <PackageGroupRef Id="NetFx472Redist" />
      <MsiPackage SourceFile="$(var.PhotoClassy.Installer.TargetPath)" />
    </Chain>
  </Bundle>
</Wix>
