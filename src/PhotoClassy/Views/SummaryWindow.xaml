<Window x:Class="PhotoClassy.Views.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="작업 결과" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        AutomationProperties.AutomationId="SummaryWindow">
    <StackPanel Margin="20" MinWidth="420">
        <TextBlock x:Name="MessageText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="480"
                   Margin="0,0,0,12" />

        <GroupBox Header="통계">
            <Grid x:Name="StatsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </GroupBox>

        <GroupBox Header="작업 시간">
            <Grid x:Name="TimeGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="대상 폴더 열기" Click="OnOpenTarget" />
            <Button Content="로그 저장" Click="OnSaveLog" />
            <Button Content="확인" Click="OnOk" AutomationProperties.AutomationId="OkButton" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
